{
  "name": "krysta-sales-backend",
  "version": "1.0.0",
  "description": "Backend API for Krysta Sales Tracker",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "minify": "node minify-dist.js",
    "db:init": "node dist/config/initDb.js",
    "db:migrate:roles": "node dist/config/migrateToRoles.js",
    "db:setup-menu": "npm run build && node dist/config/setupMenuPermissions.js",
    "db:update-role": "npm run build && node dist/config/updateUserRole.js",
    "db:check-roles": "npm run build && node dist/config/checkRoles.js"
  },
  "keywords": [
    "sales",
    "api",
    "express",
    "postgresql"
  ],
  "author": "Krysta",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expo-notifications": "^55.0.10",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "socket.io": "^4.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.3",
    "axios": "^1.13.5",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "uglify-js": "^3.19.3"
  }
}
